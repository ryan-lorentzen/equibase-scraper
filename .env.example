SUPABASE_URL=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=race-charts

SCRAPER_ENABLED=false
LOOKBACK_DAYS=7
LOG_LEVEL=INFO
REQUEST_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
MAX_CHARTS_PER_RUN=25
MAX_REQUESTS_PER_RUN=150
MAX_RETRY_WAIT_SECONDS=300
MAX_PDF_BYTES=20000000
USER_AGENT=equibase-scraper/0.1.0 (+https://github.com/ryan-lorentzen/equibase-scraper)
CHART_INDEX_URL=https://tvg.equibase.com/static/chart/pdf/
DATA_DIR=data/charts
